# SEC EDGAR
EDGAR_EMAIL=your_email@example.com
EDGAR_ORGANIZATION=YourOrganization

# OpenRouter API (primary LLM + reranker)
OPENROUTER_API_KEY=sk-or-v1-...

# Direct DeepSeek API (optional fallback)
DEEPSEEK_API_KEY=sk-...

# OpenAI API (optional)
OPENAI_API_KEY=sk-...

# Google Gemini (optional)
GOOGLE_API_KEY=...

# Neo4j
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=...


POSTGRES_DB=xxxxx
POSTGRES_USER=xxxxx
POSTGRES_PASSWORD=YOUR_PASSWORD
POSTGRES_AGENT_USER=YOUR_USER_NAME
POSTGRES_AGENT_PASSWORD=YOUR_AGENT_PASSWORD

POSTGRES_ADMIN_DSN=postgresql://semigraph_admin:YOUR_PASSWORD@localhost:5432/semigraph
POSTGRES_AGENT_DSN=postgresql://semigraph_agent:YOUR_AGENT_PASSWORD@localhost:5432/semigraph
