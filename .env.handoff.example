# Copy this file to .env before running compose.handoff.yaml.

# Required for Demo answers, Agent runs, KG extraction, and full-answer Eval.
OPENROUTER_API_KEY=

# Required only for SEC EDGAR ingestion.
EDGAR_EMAIL=advisor@example.com
EDGAR_ORGANIZATION=KMUTNB

# Local database credentials used only inside the Docker handoff runtime.
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-this-neo4j-password
POSTGRES_DB=semigraph
POSTGRES_USER=semigraph_admin
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_AGENT_USER=semigraph_agent
POSTGRES_AGENT_PASSWORD=change-this-agent-password

# Optional supporting tools.
FINNHUB_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Published private images. Change the tag only when creating a new handoff.
SEMIGRAPH_APP_IMAGE=ghcr.io/semi-graph-project/semigraph-app:advisor-v1
SEMIGRAPH_PRODUCTION_IMAGE=ghcr.io/semi-graph-project/semigraph-neo4j-production:advisor-v1
SEMIGRAPH_CONTROLLED_IMAGE=ghcr.io/semi-graph-project/semigraph-neo4j-controlled:advisor-v1
SEMIGRAPH_FINREFLECTKG_IMAGE=ghcr.io/semi-graph-project/semigraph-neo4j-finreflectkg:advisor-v1
SEMIGRAPH_POSTGRES_IMAGE=ghcr.io/semi-graph-project/semigraph-postgres:advisor-v1
